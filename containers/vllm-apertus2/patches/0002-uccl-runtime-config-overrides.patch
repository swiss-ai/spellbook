From 9c737512e7b3218fe4719b6ca9052d9369e6e51f Mon Sep 17 00:00:00 2001
From: Yueyang Pan <yupan@clariden-ln002.cscs.ch>
Date: Thu, 18 Jun 2026 15:24:06 +0200
Subject: [PATCH] [ep]: add runtime config overrides

- allow dispatch and combine Config values to be overridden from environment variables

- keep default DeepEP tuning unchanged when overrides are unset

diff --git a/ep/bench/buffer.py b/ep/bench/buffer.py
index b4d75cb180793390f820b32728fb688997635cbc..92c7e0eeddcfa9532f7714a7af1fe2226c71fe8f 100644
--- a/ep/bench/buffer.py
+++ b/ep/bench/buffer.py
@@ -737,6 +737,23 @@ class Buffer:
             raise ValueError(f"Unsupported dtype for uccl combine: {dtype}")
         return table[dtype]
 
+    @staticmethod
+    def _config_from_env(name: str) -> Optional[Config]:
+        value = os.getenv(name)
+        if not value:
+            return None
+        try:
+            parts = [int(part.strip()) for part in value.split(",")]
+        except ValueError as exc:
+            raise ValueError(
+                f"{name} must be five comma-separated integers, got {value!r}"
+            ) from exc
+        if len(parts) != 5:
+            raise ValueError(
+                f"{name} must be five comma-separated integers, got {value!r}"
+            )
+        return Config(*parts)
+
     @staticmethod
     def get_dispatch_config(num_ranks: int) -> Config:
         """
@@ -749,6 +766,10 @@ class Buffer:
             config: the recommended config.
         """
 
+        env_config = Buffer._config_from_env("UCCL_EP_DISPATCH_CONFIG")
+        if env_config is not None:
+            return env_config
+
         # TODO: automatically tune
         config_map = {
             2: Config(Buffer.num_sms, 24, 256, 6, 128),
@@ -777,6 +798,10 @@ class Buffer:
             config: the recommended config.
         """
 
+        env_config = Buffer._config_from_env("UCCL_EP_COMBINE_CONFIG")
+        if env_config is not None:
+            return env_config
+
         # TODO: automatically tune
         config_map = {
             2: Config(Buffer.num_sms, 10, 256, 6, 128),
