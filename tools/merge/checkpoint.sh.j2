#!/bin/bash
#SBATCH --nodes={{ nodes }}
#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
#SBATCH --ntasks-per-node={{ workers_per_node }}
#SBATCH --cpus-per-task={{ cpus_per_task }}
#SBATCH --time={{ run_time }}
#SBATCH --job-name=merge_{{ name }}
#SBATCH --output={{ log_dir }}/{{ name }}-%j.log
#SBATCH --error={{ log_dir }}/{{ name }}-%j.log
#SBATCH --exclusive
{%- if gpus_per_node %}
#SBATCH --gpus-per-node={{ gpus_per_node }}
{%- endif %}
{%- if memory %}
#SBATCH --mem={{ memory }}
{%- endif %}
{%- if reservation %}
#SBATCH --reservation={{ reservation }}
{%- endif %}
{%- if exclude %}
#SBATCH --exclude={{ exclude }}
{%- endif %}

set -e
ulimit -c 0

{% include "megatron_checkout.sh.j2" %}

export MEGATRON_GIT_BRANCH="$(git -C "${MEGATRON_PATH}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
export MEGATRON_GIT_COMMIT="$(git -C "${MEGATRON_PATH}" rev-parse HEAD 2>/dev/null || echo unknown)"
export MEGATRON_GIT_URL="$(git -C "${MEGATRON_PATH}" remote get-url origin 2>/dev/null || echo unknown)"
echo "Megatron branch: ${MEGATRON_GIT_BRANCH}"
echo "Megatron commit: ${MEGATRON_GIT_COMMIT}"
echo "Megatron url:    ${MEGATRON_GIT_URL}"

srun \
  --nodes={{ nodes }} \
  --ntasks={{ total_workers }} \
  --ntasks-per-node={{ workers_per_node }} \
  --cpus-per-task={{ cpus_per_task }} \
  --export=ALL,MEGATRON_PATH \
  --mpi=pmix \
  --kill-on-bad-exit=1 \
  -l \
{%- if container_edf %}
  --environment="{{ container_edf }}" \
{%- endif %}
{%- if container_mounts %}
  --container-mounts="{{ container_mounts }}" \
{%- endif %}
{%- if srun_extra_args %}
  {{ srun_extra_args }} \
{%- endif %}
  -u bash -lc '
set -e
ulimit -c 0

{% if container_edf %}
{% include "megatron_copy.sh.j2" %}
{% endif %}

export PYTHONPATH="${MEGATRON_PATH}:${PYTHONPATH:-}"
{% for key, value in env_vars.items() %}
export {{ key }}={{ value | tojson }}
{%- endfor %}

numactl --cpunodebind="${SLURM_LOCALID}" --membind="${SLURM_LOCALID}" \
  python \
  "${MEGATRON_PATH}/tools/checkpoint/merge.py" \
  {{ merge_args | join(" \\\n  ") }}
'
