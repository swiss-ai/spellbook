#!/bin/bash
#SBATCH --nodes={{ nodes }}
#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
#SBATCH --ntasks-per-node={{ workers_per_node }}
#SBATCH --cpus-per-task={{ cpus_per_task }}
#SBATCH --time={{ run_time }}
#SBATCH --job-name=merge_{{ name }}
#SBATCH --output={{ log_dir }}/{{ name }}-%j.log
#SBATCH --error={{ log_dir }}/{{ name }}-%j.log
#SBATCH --exclusive
{%- if gpus_per_node %}
#SBATCH --gpus-per-node={{ gpus_per_node }}
{%- endif %}
{%- if memory %}
#SBATCH --mem={{ memory }}
{%- endif %}
{%- if reservation %}
#SBATCH --reservation={{ reservation }}
{%- endif %}
{%- if qos %}
#SBATCH --qos={{ qos }}
{%- endif %}
{%- if exclude %}
#SBATCH --exclude={{ exclude }}
{%- endif %}

set -e
ulimit -c 0

{% include "megatron_checkout.sh.j2" %}


srun \
  --cpus-per-task={{ cpus_per_task }} \
  --export=ALL,MEGATRON_PATH \
  --mpi=pmix \
  --kill-on-bad-exit=1 \
  -l \
{%- if container_edf %}
  --environment="{{ container_edf }}" \
{%- endif %}
{%- if container_mounts %}
  --container-mounts="{{ container_mounts }}" \
{%- endif %}
{%- if srun_extra_args %}
  {{ srun_extra_args }} \
{%- endif %}
  -u bash -lc '
set -e
ulimit -c 0

{% if container_edf %}
{% include "megatron_copy.sh.j2" %}
{% endif %}

export PYTHONPATH="${MEGATRON_PATH}:${PYTHONPATH:-}"
{% for key, value in env_vars.items() %}
export {{ key }}={{ value | tojson }}
{%- endfor %}

numactl --cpunodebind="${SLURM_LOCALID}" --membind="${SLURM_LOCALID}" \
  python \
  "${MEGATRON_PATH}/tools/checkpoint/merge.py" \
  {{ merge_args | join(" \\\n  ") }}
'
