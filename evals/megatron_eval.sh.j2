#!/bin/bash
#SBATCH --nodes={{ nodes }}
#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
#SBATCH --ntasks-per-node={{ ntasks_per_node }}
#SBATCH --time={{ run_time }}
#SBATCH --job-name=eval_{{ model_name }}
#SBATCH --output={{ log_dir }}/{{ model_name }}/{{ model_name }}-{{ ckpt_step }}-{{ date }}-%j.out
#SBATCH --error={{ log_dir }}/{{ model_name }}/{{ model_name }}-{{ ckpt_step }}-{{ date }}-%j.err
#SBATCH --exclusive
#SBATCH --gres=gpu:{{ gpus_per_node }}
{%- if dependency_singleton %}
#SBATCH --dependency=singleton
{%- endif %}
{%- if reservation %}
#SBATCH --reservation={{ reservation }}
{%- endif %}

source .env
export HF_TOKEN="${HF_TOKEN}"
export WANDB_API_KEY="${WANDB_API_KEY}"

set -x
ulimit -c 0

# --- Distributed setup ---
export LOCAL_RANK=${SLURM_LOCALID}
export RANK="${SLURM_PROCID}"
export GPUS_PER_NODE="${SLURM_GPUS_ON_NODE}"
export HOSTNAMES="$(scontrol show hostnames "$SLURM_JOB_NODELIST")"
export MASTER_ADDR="$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)"
export MASTER_PORT=6991
export WORLD_SIZE="${SLURM_NTASKS:-{{ total_tasks }}}"
export SLURM_JOB_ID="${SLURM_JOB_ID}"
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export CUDA_CACHE_DISABLE=1

export MODEL_NAME="{{ model_name }}"
export CKPT_STEP="{{ ckpt_step }}"

# --- Megatron worktree pin ---
{% if megatron_commit %}
MEGATRON_WORKTREE_PATH="${SCRATCH}/tmp/megatron_worktree_{{ megatron_commit }}"
if [[ ! -d "${MEGATRON_WORKTREE_PATH}" ]]; then
  echo "Creating Megatron-LM worktree at commit {{ megatron_commit }}"
  mkdir -p "$(dirname "${MEGATRON_WORKTREE_PATH}")"
  git -C "{{ megatron_path }}" worktree add "${MEGATRON_WORKTREE_PATH}" "{{ megatron_commit }}"
fi
export MEGATRON_PATH="${MEGATRON_WORKTREE_PATH}"
{% else %}
export MEGATRON_PATH="{{ megatron_path }}"
{% endif %}

mkdir -p {{ log_dir }}/{{ model_name }}

export OUTPUT_DIR="evals/{{ model_name }}/step_{{ ckpt_step }}"

srun \
{%- if launch_mode == "tasks" %}
  --ntasks={{ total_tasks }} \
  --ntasks-per-node={{ gpus_per_node }} \
{%- endif %}
  --export=LOCAL_RANK,RANK,GPUS_PER_NODE,HOSTNAMES,MASTER_ADDR,MASTER_PORT,WORLD_SIZE,SLURM_JOB_ID,TORCH_NCCL_ASYNC_ERROR_HANDLING,CUDA_CACHE_DISABLE,MEGATRON_PATH,HF_TOKEN,WANDB_API_KEY,MODEL_NAME,CKPT_STEP,OUTPUT_DIR \
  --mpi=pmix -l \
{%- if container_edf %}
  --environment="{{ container_edf }}" \
{%- endif %}
{%- if container_mounts %}
  --container-mounts="{{ container_mounts }}" \
{%- endif %}
  -u bash -lc '
set -x
ulimit -c 0

{% if launch_mode == "tasks" %}
export RANK="${SLURM_PROCID}"
export LOCAL_RANK="${SLURM_LOCALID}"
export WORLD_SIZE="${SLURM_NTASKS:-{{ total_tasks }}}"
export MASTER_ADDR="${MASTER_ADDR}"
export MASTER_PORT="${MASTER_PORT}"

{% endif %}
export MEGATRON_PATH="${MEGATRON_PATH}"
export PYTHONPATH="${MEGATRON_PATH}:${PYTHONPATH:-}"

export NVTE_ALLOW_NONDETERMINISTIC_ALGO="1"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
export NCCL_NVLS_ENABLE="0"
export TORCH_NCCL_AVOID_RECORD_STREAMS="0"
export NCCL_GRAPH_REGISTER="0"
export TORCH_NCCL_HIGH_PRIORITY="1"
unset NVTE_FUSED_ATTN
export NVTE_NORM_FWD_USE_CUDNN="1"
export NVTE_NORM_BWD_USE_CUDNN="0"
export NVTE_USE_CUTLASS_GROUPED_GEMM="0"
export NVTE_CUTLASS_GROUPED_GEMM_WARN_FALLBACK="1"
export TOKENIZERS_PARALLELISM="False"
export NCCL_DEBUG="WARN"
export HF_HUB_OFFLINE="0"
export CUDA_DEVICE_MAX_CONNECTIONS="1"
export NVTE_FWD_LAYERNORM_SM_MARGIN="0"
export NVTE_BWD_LAYERNORM_SM_MARGIN="0"

export TRITON_HOME=/tmp/.triton/${SLURM_PROCID}
export TRITON_CACHE_DIR=/tmp/.triton/${SLURM_PROCID}/cache
export TORCHINDUCTOR_CACHE_DIR=/tmp/.torchinductor/${SLURM_PROCID}

{% if env_vars %}
{% for key, val in env_vars.items() %}
export {{ key }}="{{ val }}"
{% endfor %}
{% endif %}

{% if lm_eval_install %}
pip install {{ lm_eval_install }} --no-build-isolation
{% endif %}

{% if hf_home %}
export HF_HOME="{{ hf_home }}"
export HF_DATASETS_CACHE="{{ hf_home }}"
{% endif %}

{% if dataset_prefetch %}
if [[ "${SLURM_PROCID}" == "0" ]]; then
  python3 << '"'"'PYEOF'"'"'
from datasets import load_dataset
{% for task, args in dataset_prefetch.items() %}
load_dataset({{ args | map("tojson") | join(", ") }})
{% endfor %}
PYEOF
fi
{% endif %}

NPROC_PER_NODE={{ gpus_per_node }}
NNODES=$(echo "$HOSTNAMES" | wc -l)
NODE_RANK=${SLURM_PROCID}
NUM_GPUS={{ devices }}

mkdir -p "${OUTPUT_DIR}"

# Only the first node logs to wandb; otherwise every node task initializes the
# same run id concurrently, which collides and hangs at wandb sync.
WANDB_ARGS=""
{%- if wandb_project %}
if [[ "${SLURM_PROCID}" == "0" ]]; then
  WANDB_ARGS="--wandb_args project={{ wandb_project }},id={{ wandb_id if wandb_id else model_name }},step=${CKPT_STEP},resume=allow"
fi
{%- endif %}

{% if install_commands %}
# --- Install packages ---
{{ install_commands }}
{% endif %}

# Turn off hf hub so we dont have all ranks doing requests to the HF api and making us get rate limited
export HF_HUB_OFFLINE=1

{% if launch_mode == "tasks" %}
numactl --cpunodebind="${SLURM_LOCALID}" --membind="${SLURM_LOCALID}" \
  python -m lm_eval --model megatron_lm \
    --model_args "load={{ checkpoint_dir }}/${MODEL_NAME},tokenizer_type=HuggingFaceTokenizer,tokenizer_model={{ tokenizer_model }},ckpt_step=${CKPT_STEP},transformer_impl=transformer_engine,devices=$NUM_GPUS,EP={{ ep }}{% if extra_args %},extra_args={{ extra_args }}{% endif %}" \
    --tasks {{ tasks_str }} \
    --batch_size {{ batch_size }} \
    --output_path ${OUTPUT_DIR} \
    ${WANDB_ARGS}
{% else %}
python -m torch.distributed.run \
  --nproc-per-node=$NPROC_PER_NODE \
  --nnodes=$NNODES \
  --node-rank=$NODE_RANK \
  --master-addr=$MASTER_ADDR \
  --master-port=$MASTER_PORT \
  -m lm_eval --model megatron_lm \
    --model_args "load={{ checkpoint_dir }}/${MODEL_NAME},tokenizer_type=HuggingFaceTokenizer,tokenizer_model={{ tokenizer_model }},ckpt_step=${CKPT_STEP},transformer_impl=transformer_engine,devices=$NUM_GPUS,EP={{ ep }}{% if extra_args %},extra_args={{ extra_args }}{% endif %}" \
    --tasks {{ tasks_str }} \
    --batch_size {{ batch_size }} \
    --output_path ${OUTPUT_DIR} \
    ${WANDB_ARGS}
{% endif %}
'
