#!/bin/bash
#SBATCH --nodes={{ nodes }}
#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
#SBATCH --ntasks-per-node={{ ntasks_per_node }}
{%- if cpus_per_task %}
#SBATCH --cpus-per-task={{ cpus_per_task }}
{%- endif %}
#SBATCH --time={{ run_time }}
#SBATCH --job-name=eval_{{ model_name }}
#SBATCH --output={{ log_dir }}/{{ model_name }}/{{ model_name }}-{{ ckpt_step }}-{{ date }}-%j.out
#SBATCH --error={{ log_dir }}/{{ model_name }}/{{ model_name }}-{{ ckpt_step }}-{{ date }}-%j.err
#SBATCH --exclusive
#SBATCH --gres=gpu:{{ gpus_per_node }}
{%- if dependency_singleton %}
#SBATCH --dependency=singleton
{%- endif %}
{%- if reservation %}
#SBATCH --reservation={{ reservation }}
{%- endif %}
{%- if exclude %}
#SBATCH --exclude={{ exclude }}
{%- endif %}

set -e

if [[ -f ".env" ]]; then
  source ".env"
fi
export HF_TOKEN="${HF_TOKEN}"
export WANDB_API_KEY="${WANDB_API_KEY}"

set -x
ulimit -c 0

# --- Distributed setup ---
export LOCAL_RANK=${SLURM_LOCALID}
export RANK="${SLURM_PROCID}"
export GPUS_PER_NODE="${SLURM_GPUS_ON_NODE}"
export HOSTNAMES="$(scontrol show hostnames "$SLURM_JOB_NODELIST")"
export MASTER_ADDR="$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)"
export MASTER_PORT="${MASTER_PORT:-6991}"
export WORLD_SIZE="${SLURM_NTASKS:-{{ total_tasks }}}"
export SLURM_JOB_ID="${SLURM_JOB_ID}"
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export CUDA_CACHE_DISABLE=1

export MODEL_NAME="{{ model_name }}"
export CKPT_STEP="{{ ckpt_step }}"

# --- Megatron checkout ---
MEGATRON_CACHE_ROOT="${SCRATCH:-${TMPDIR:-/tmp}/spellbook-${USER:-$(id -u)}}/tmp"
{% if megatron_url %}
MEGATRON_REPO_PATH="${MEGATRON_CACHE_ROOT}/megatron_repos/{{ megatron_cache_key }}"
mkdir -p "$(dirname "${MEGATRON_REPO_PATH}")"
(
  flock -x 9
  if [[ ! -d "${MEGATRON_REPO_PATH}/.git" ]]; then
    echo "Cloning Megatron-LM from {{ megatron_url }}"
    git clone "{{ megatron_url }}" "${MEGATRON_REPO_PATH}"
  fi
  echo "Refreshing cached Megatron-LM repository"
  git -C "${MEGATRON_REPO_PATH}" fetch origin --tags --prune
) 9>"${MEGATRON_REPO_PATH}.lock"
MEGATRON_SOURCE_PATH="${MEGATRON_REPO_PATH}"
{% else %}
MEGATRON_SOURCE_PATH="{{ megatron_path }}"
{% endif %}

# URL sources always use a worktree so an unpinned URL can follow the refreshed
# remote default branch without mutating the shared clone checkout.
{% if megatron_commit or megatron_url %}
{% if megatron_commit %}
MEGATRON_REQUESTED_REF="{{ megatron_commit }}"
{% if megatron_url %}
if git -C "${MEGATRON_SOURCE_PATH}" rev-parse --verify     "refs/remotes/origin/${MEGATRON_REQUESTED_REF}^{commit}" >/dev/null 2>&1; then
  MEGATRON_REQUESTED_REF="refs/remotes/origin/${MEGATRON_REQUESTED_REF}"
fi
{% endif %}
{% else %}
MEGATRON_REQUESTED_REF="refs/remotes/origin/HEAD"
{% endif %}
if ! MEGATRON_TARGET_COMMIT="$(git -C "${MEGATRON_SOURCE_PATH}" rev-parse --verify "${MEGATRON_REQUESTED_REF}^{commit}")"; then
  echo "Cannot resolve Megatron ref ${MEGATRON_REQUESTED_REF} in ${MEGATRON_SOURCE_PATH}" >&2
  exit 1
fi
MEGATRON_WORKTREE_PATH="${MEGATRON_CACHE_ROOT}/megatron_worktrees/{{ megatron_worktree_key }}"
mkdir -p "$(dirname "${MEGATRON_WORKTREE_PATH}")"
(
  flock -x 9
  if [[ -d "${MEGATRON_WORKTREE_PATH}" ]]; then
    MEGATRON_WORKTREE_COMMIT="$(git -C "${MEGATRON_WORKTREE_PATH}" rev-parse HEAD 2>/dev/null || true)"
    if [[ "${MEGATRON_WORKTREE_COMMIT}" != "${MEGATRON_TARGET_COMMIT}" ]]; then
      git -C "${MEGATRON_SOURCE_PATH}" worktree remove --force "${MEGATRON_WORKTREE_PATH}" 2>/dev/null ||
        rm -rf "${MEGATRON_WORKTREE_PATH}"
    fi
  fi
  if [[ ! -d "${MEGATRON_WORKTREE_PATH}" ]]; then
    echo "Creating Megatron-LM worktree at commit ${MEGATRON_TARGET_COMMIT}"
    git -C "${MEGATRON_SOURCE_PATH}" worktree add --detach       "${MEGATRON_WORKTREE_PATH}" "${MEGATRON_TARGET_COMMIT}"
  fi
) 9>"${MEGATRON_WORKTREE_PATH}.lock"
export MEGATRON_PATH="${MEGATRON_WORKTREE_PATH}"
{% else %}
export MEGATRON_PATH="${MEGATRON_SOURCE_PATH}"
{% endif %}

mkdir -p {{ log_dir }}/{{ model_name }}

export OUTPUT_DIR="{{ suite_output_dir }}"

srun \
{%- if cpus_per_task %}
  --cpus-per-task={{ cpus_per_task }} \
{%- endif %}
  --export=LOCAL_RANK,RANK,GPUS_PER_NODE,HOSTNAMES,MASTER_ADDR,MASTER_PORT,WORLD_SIZE,SLURM_JOB_ID,TORCH_NCCL_ASYNC_ERROR_HANDLING,CUDA_CACHE_DISABLE,MEGATRON_PATH,HF_TOKEN,WANDB_API_KEY,MODEL_NAME,CKPT_STEP,OUTPUT_DIR \
  --kill-on-bad-exit=1 \
  --mpi=pmix -l \
{%- if container_edf %}
  --environment="{{ container_edf }}" \
{%- endif %}
{%- if container_mounts %}
  --container-mounts="{{ container_mounts }}" \
{%- endif %}
{%- if srun_extra_args %}
  {{ srun_extra_args }} \
{%- endif %}
  -u bash -lc '
set -e
set -x
ulimit -c 0

# Global readiness barrier on IOPStor. Each rank publishes completion of
# Megatron copy/package setup before any rank launches the training process.
SPELLBOOK_READY_DIR="${SPELLBOOK_READY_DIR:-${SCRATCH:-/iopsstor/scratch/cscs/${USER}}/tmp/spellbook-readiness/${SLURM_JOB_ID}}"
SPELLBOOK_READY_TIMEOUT="${SPELLBOOK_READY_TIMEOUT:-600}"
if [[ "${SLURM_PROCID}" == "0" ]]; then
  rm -rf "${SPELLBOOK_READY_DIR}"
  mkdir -p "${SPELLBOOK_READY_DIR}"
  : > "${SPELLBOOK_READY_DIR}/.initialized"
else
  until [[ -f "${SPELLBOOK_READY_DIR}/.initialized" ]]; do
    sleep 1
  done
fi


{% if launch_mode == "tasks" %}
export RANK="${SLURM_PROCID}"
export LOCAL_RANK="${SLURM_LOCALID}"
export WORLD_SIZE="${SLURM_NTASKS:-{{ total_tasks }}}"
export MASTER_ADDR="${MASTER_ADDR}"
export MASTER_PORT="${MASTER_PORT}"

{% endif %}

{% if container_edf %}
# Container filesystems are shared by tasks on the same node. Copy from one
# local rank and make the other local ranks wait before importing Megatron.
MEGATRON_SOURCE_PATH="${MEGATRON_PATH}"
MEGATRON_DIR_NAME="$(basename "${MEGATRON_SOURCE_PATH}")"
if [[ -z "${MEGATRON_SOURCE_PATH}" ||
      "${MEGATRON_DIR_NAME}" == "." ||
      "${MEGATRON_DIR_NAME}" == ".." ||
      "${MEGATRON_DIR_NAME}" == "/" ]]; then
  echo "Cannot copy unsafe Megatron source path: ${MEGATRON_SOURCE_PATH}" >&2
  exit 1
fi
MEGATRON_CONTAINER_PATH="{{ megatron_container_path }}"
if ! MEGATRON_SOURCE_REAL="$(realpath -e "${MEGATRON_SOURCE_PATH}")"; then
  echo "Megatron source path does not exist: ${MEGATRON_SOURCE_PATH}" >&2
  exit 1
fi
MEGATRON_CONTAINER_REAL="$(realpath -m "${MEGATRON_CONTAINER_PATH}")"
if [[ "${MEGATRON_SOURCE_REAL}" != "${MEGATRON_CONTAINER_REAL}" ]] &&
   { [[ "${MEGATRON_SOURCE_REAL}/" == "${MEGATRON_CONTAINER_REAL}/"* ]] ||
     [[ "${MEGATRON_CONTAINER_REAL}/" == "${MEGATRON_SOURCE_REAL}/"* ]]; }; then
  echo "Megatron source and container destination must not contain one another" >&2
  exit 1
fi
MEGATRON_COPY_STATUS="/tmp/spellbook-megatron-copy-${SLURM_JOB_ID:-0}-${SLURM_STEP_ID:-0}.status"
if [[ "${SLURM_LOCALID:-0}" == "0" ]]; then
  if [[ "${MEGATRON_SOURCE_PATH}" == "${MEGATRON_CONTAINER_PATH}" ]]; then
    MEGATRON_COPY_RC=0
  elif rm -rf "${MEGATRON_CONTAINER_PATH}" &&
       cp -R --no-preserve=all \
         "${MEGATRON_SOURCE_PATH}" "${MEGATRON_CONTAINER_PATH}"; then
    MEGATRON_COPY_RC=0
  else
    MEGATRON_COPY_RC=$?
  fi
  printf "%s\n" "${MEGATRON_COPY_RC}" > "${MEGATRON_COPY_STATUS}.tmp"
  mv -f "${MEGATRON_COPY_STATUS}.tmp" "${MEGATRON_COPY_STATUS}"
else
  while [[ ! -f "${MEGATRON_COPY_STATUS}" ]]; do
    sleep 1
  done
  MEGATRON_COPY_RC="$(<"${MEGATRON_COPY_STATUS}")"
fi
if [[ "${MEGATRON_COPY_RC}" != "0" ]]; then
  echo "Copying Megatron into the container failed on $(hostname) with exit code ${MEGATRON_COPY_RC}" >&2
  exit "${MEGATRON_COPY_RC}"
fi
export MEGATRON_PATH="${MEGATRON_CONTAINER_PATH}"

{% endif %}

export PYTHONPATH="${MEGATRON_PATH}:${PYTHONPATH:-}"

export NVTE_ALLOW_NONDETERMINISTIC_ALGO="1"
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
export NCCL_NVLS_ENABLE="0"
export TORCH_NCCL_AVOID_RECORD_STREAMS="0"
export NCCL_GRAPH_REGISTER="0"
export TORCH_NCCL_HIGH_PRIORITY="1"
unset NVTE_FUSED_ATTN
export NVTE_NORM_FWD_USE_CUDNN="1"
export NVTE_NORM_BWD_USE_CUDNN="0"
export NVTE_USE_CUTLASS_GROUPED_GEMM="0"
export NVTE_CUTLASS_GROUPED_GEMM_WARN_FALLBACK="1"
export TOKENIZERS_PARALLELISM="False"
export NCCL_DEBUG="WARN"
export HF_HUB_OFFLINE="0"
export CUDA_DEVICE_MAX_CONNECTIONS="1"
export NVTE_FWD_LAYERNORM_SM_MARGIN="0"
export NVTE_BWD_LAYERNORM_SM_MARGIN="0"

export TRITON_HOME=/tmp/.triton/${SLURM_PROCID}
export TRITON_CACHE_DIR=/tmp/.triton/${SLURM_PROCID}/cache
export TORCHINDUCTOR_CACHE_DIR=/tmp/.torchinductor/${SLURM_PROCID}
mkdir -p "${TRITON_CACHE_DIR}" "${TORCHINDUCTOR_CACHE_DIR}"

{% if env_vars %}
{% for key, val in env_vars.items() %}
export {{ key }}="{{ val }}"
{% endfor %}
{% endif %}

{% if hf_home %}
export HF_HOME="{{ hf_home }}"
export HF_DATASETS_CACHE="{{ hf_home }}"
{% endif %}

{% if lm_eval_install or install_commands %}
# Container filesystems are shared by tasks on the same node. Install from one
# local rank and make the other local ranks wait before importing the packages.
INSTALL_STATUS="/tmp/spellbook-lm-eval-install-${SLURM_JOB_ID}-${SLURM_STEP_ID:-0}.status"
if [[ "${SLURM_LOCALID:-0}" == "0" ]]; then
  set +e
  (
    set -e
{% if lm_eval_install %}
{% if lm_eval_install_with_python %}python -m {% endif %}pip install {{ lm_eval_install }} --no-build-isolation
{% endif %}
{% if install_commands %}
# --- Install packages ---
{{ install_commands }}
{% endif %}
  )
  INSTALL_RC=$?
  printf "%s\n" "${INSTALL_RC}" > "${INSTALL_STATUS}.tmp"
  mv -f "${INSTALL_STATUS}.tmp" "${INSTALL_STATUS}"
  set -e
else
  while [[ ! -f "${INSTALL_STATUS}" ]]; do
    sleep 1
  done
  INSTALL_RC="$(<"${INSTALL_STATUS}")"
fi
if [[ "${INSTALL_RC}" != "0" ]]; then
  echo "Package installation failed on $(hostname) with exit code ${INSTALL_RC}" >&2
  exit "${INSTALL_RC}"
fi
{% endif %}

# Publish readiness only after copy and package installation have completed.
printf "%s\n" "$(hostname)" > "${SPELLBOOK_READY_DIR}/${SLURM_PROCID}.ready.tmp"
mv -f "${SPELLBOOK_READY_DIR}/${SLURM_PROCID}.ready.tmp" "${SPELLBOOK_READY_DIR}/${SLURM_PROCID}.ready"
READY_WAIT_START="${SECONDS}"
while true; do
  READY_COUNT="$(find "${SPELLBOOK_READY_DIR}" -maxdepth 1 -type f -name '*.ready' | wc -l)"
  if (( READY_COUNT >= SLURM_NTASKS )); then
    break
  fi
  if (( SECONDS - READY_WAIT_START >= SPELLBOOK_READY_TIMEOUT )); then
    echo "Timed out waiting for all ranks: ${READY_COUNT}/${SLURM_NTASKS} ready" >&2
    find "${SPELLBOOK_READY_DIR}" -maxdepth 1 -type f -name '*.ready' -printf '%f\n' | sort >&2
    exit 1
  fi
  sleep 1
done

mkdir -p "${OUTPUT_DIR}"

{% include "dataset_prefetch.sh.j2" %}

NPROC_PER_NODE={{ gpus_per_node }}
NNODES=$(echo "$HOSTNAMES" | wc -l)
NODE_RANK=${SLURM_PROCID}

# Turn off hf hub so we dont have all ranks doing requests to the HF api and making us get rate limited
export HF_HUB_OFFLINE=1

{% if eval_runs | length > 1 %}
SUITE_BARRIER_ROOT="${OUTPUT_DIR}/.spellbook-suite-${SLURM_JOB_ID}"
mkdir -p "${SUITE_BARRIER_ROOT}"
suite_barrier() {
  local run_index="$1"
  local barrier_dir="${SUITE_BARRIER_ROOT}/${run_index}"
  mkdir -p "${barrier_dir}"
  touch "${barrier_dir}/rank-${SLURM_PROCID}"
  while (( $(find "${barrier_dir}" -maxdepth 1 -type f -name "rank-*" | wc -l) < {{ total_tasks }} )); do
    sleep 1
  done
}
{% endif %}

{% for eval_run in eval_runs %}
echo "Starting checkpoint {{ eval_run.ckpt_step }} lm-eval run {{ eval_run.name }}"
(
export CKPT_STEP="{{ eval_run.ckpt_step }}"
export OUTPUT_DIR="{{ eval_run.output_path }}"
mkdir -p "${OUTPUT_DIR}"
{% for key, val in eval_run.env_vars.items() %}
export {{ key }}="{{ val }}"
{% endfor %}

# Only the first Slurm task logs to WandB.
WANDB_ARGS=()
{% if wandb_project %}
if [[ "${SLURM_PROCID}" == "0" ]]; then
  WANDB_ARGS=({{ eval_run.wandb_args_line }})
  CHECKPOINT_METADATA="{{ eval_run.checkpoint_path }}/common.pt"
  if [[ ! -f "${CHECKPOINT_METADATA}" ]]; then
    CHECKPOINT_METADATA="$(find "{{ eval_run.checkpoint_path }}" -maxdepth 2 -type f -path "*/mp_rank*/model_optim_rng.pt" -print -quit 2>/dev/null || true)"
  fi
  if [[ -n "${CHECKPOINT_METADATA}" && -f "${CHECKPOINT_METADATA}" ]]; then
    TOTAL_FLOPS="$(python - "${CHECKPOINT_METADATA}" <<PY
import sys

import torch

state = torch.load(sys.argv[1], map_location="cpu", weights_only=False)
total_flops = state.get("num_floating_point_operations_so_far")
if total_flops is not None:
    print(total_flops)
PY
)"
    if [[ -n "${TOTAL_FLOPS}" ]]; then
      WANDB_ARGS[1]="${WANDB_ARGS[1]},total_flops=${TOTAL_FLOPS}"
    else
      echo "No cumulative FLOPs field found in ${CHECKPOINT_METADATA}" >&2
    fi
  else
    echo "No checkpoint metadata file found in {{ eval_run.checkpoint_path }}" >&2
  fi
fi
{% endif %}

{% if launch_mode == "tasks" %}
numactl --cpunodebind="${SLURM_LOCALID}" --membind="${SLURM_LOCALID}" \
  python -m lm_eval \
    {{ eval_run.lm_eval_args_lines | join(" \\\n    ") }} \
    "${WANDB_ARGS[@]}"
{% else %}
python -m torch.distributed.run \
  --nproc-per-node=$NPROC_PER_NODE \
  --nnodes=$NNODES \
  --node-rank=$NODE_RANK \
  --master-addr=$MASTER_ADDR \
  --master-port=$MASTER_PORT \
  -m lm_eval \
    {{ eval_run.lm_eval_args_lines | join(" \\\n    ") }} \
    "${WANDB_ARGS[@]}"
{% endif %}
)
{% if eval_runs | length > 1 %}
suite_barrier {{ loop.index0 }}
{% endif %}
{% endfor %}
'
{% if eval_runs | length > 1 %}
rm -rf "{{ suite_output_dir }}/.spellbook-suite-${SLURM_JOB_ID}"
{% endif %}
