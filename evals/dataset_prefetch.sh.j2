{% if dataset_prefetch %}
# Work around lm-eval distributed ranks concurrently building process_docs caches.
# This coordination belongs upstream in lm-eval; keep this API use aligned with:
# {{ lm_eval_install or "the lm-eval version provided by the container" }}
# OUTPUT_DIR is shared by all nodes, so it also provides a global prefetch
# barrier before ranks switch Hugging Face into offline mode.

PREFETCH_STATUS="${OUTPUT_DIR}/.spellbook-dataset-prefetch-${SLURM_JOB_ID}.status"
if [[ "${SLURM_PROCID}" == "0" ]]; then
  set +e
  (
    set -e
    timeout --signal=TERM {{ prefetch_timeout_seconds }}s python << 'PYEOF'
from importlib.metadata import version

from datasets import load_dataset
from lm_eval.config import EvaluatorConfig
from lm_eval.tasks import get_task_dict

lm_eval_version = version("lm_eval")
print(f"lm-eval version used for dataset prefetch: {lm_eval_version}")
{% for task, args in dataset_prefetch.items() %}
load_dataset({{ args | map("tojson") | join(", ") }})
{% endfor %}
# Build task-specific process_docs/dataset.map caches before releasing other ranks.
{% for run in dataset_prefetch_runs %}
eval_config = EvaluatorConfig(
    tasks={{ run.tasks | tojson }},
    metadata={{ metadata | tojson }},{% if run.include_path %}
    include_path={{ run.include_path | tojson }},{% endif %}
)
task_manager = eval_config.process_tasks()
get_task_dict(eval_config.tasks, task_manager=task_manager)
{% endfor %}
PYEOF
  )
  PREFETCH_RC=$?
  printf "%s\n" "${PREFETCH_RC}" > "${PREFETCH_STATUS}.tmp"
  mv -f "${PREFETCH_STATUS}.tmp" "${PREFETCH_STATUS}"
  set -e
else
  PREFETCH_DEADLINE=$((SECONDS + {{ prefetch_timeout_seconds }}))
  while [[ ! -f "${PREFETCH_STATUS}" ]]; do
    if (( SECONDS >= PREFETCH_DEADLINE )); then
      echo "Timed out waiting for dataset prefetch status at ${PREFETCH_STATUS}" >&2
      exit 124
    fi
    sleep 1
  done
  PREFETCH_RC="$(<"${PREFETCH_STATUS}")"
fi
if [[ "${PREFETCH_RC}" != "0" ]]; then
  echo "Dataset prefetch failed with exit code ${PREFETCH_RC}" >&2
  exit "${PREFETCH_RC}"
fi
{% endif %}
