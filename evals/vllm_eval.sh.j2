#!/bin/bash
#SBATCH --nodes=1
#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task={{ cpus_per_task }}
#SBATCH --time={{ run_time }}
#SBATCH --job-name=eval_{{ model_name }}
#SBATCH --output={{ log_dir }}/{{ model_name }}/{{ model_name }}-%j.out
#SBATCH --error={{ log_dir }}/{{ model_name }}/{{ model_name }}-%j.err
#SBATCH --exclusive
#SBATCH --gres=gpu:{{ gpus_per_node }}
{%- if memory %}
#SBATCH --mem={{ memory }}
{%- endif %}
{%- if conversion_job_id %}
#SBATCH --dependency=afterok:{{ conversion_job_id }}
{%- endif %}
{%- if reservation %}
#SBATCH --reservation={{ reservation }}
{%- endif %}
{%- if exclude %}
#SBATCH --exclude={{ exclude }}
{%- endif %}

set -e

if [[ -f ".env" ]]; then
  source ".env"
fi
export HF_TOKEN="${HF_TOKEN:-}"
export WANDB_API_KEY="${WANDB_API_KEY:-}"
export OUTPUT_DIR="{{ output_dir }}"

mkdir -p "${OUTPUT_DIR}" "{{ log_dir }}/{{ model_name }}"

srun \
  --cpus-per-task={{ cpus_per_task }} \
  --export=ALL,OUTPUT_DIR,HF_TOKEN,WANDB_API_KEY \
{%- if container_edf %}
  --environment="{{ container_edf }}" \
{%- endif %}
{%- if container_mounts %}
  --container-mounts="{{ container_mounts }}" \
{%- endif %}
{%- if srun_extra_args %}
  {{ srun_extra_args }} \
{%- endif %}
  -u bash -lc '
set -e
set -x
ulimit -c 0

export TOKENIZERS_PARALLELISM="False"
export NCCL_DEBUG="${NCCL_DEBUG:-WARN}"
export NCCL_NVLS_ENABLE="${NCCL_NVLS_ENABLE:-0}"
export CUDA_DEVICE_MAX_CONNECTIONS="${CUDA_DEVICE_MAX_CONNECTIONS:-1}"

JOB_CACHE_KEY="${SLURM_JOB_ID:-local}-${SLURM_STEP_ID:-0}"
export TRITON_HOME="/tmp/.triton/${JOB_CACHE_KEY}"
export TRITON_CACHE_DIR="${TRITON_HOME}/cache"
export TORCHINDUCTOR_CACHE_DIR="/tmp/.torchinductor/${JOB_CACHE_KEY}"
mkdir -p "${TRITON_CACHE_DIR}" "${TORCHINDUCTOR_CACHE_DIR}" "${OUTPUT_DIR}"

{% if env_vars %}
{% for key, val in env_vars.items() %}
export {{ key }}="{{ val }}"
{% endfor %}
{% endif %}

{% if hf_home %}
export HF_HOME="{{ hf_home }}"
export HF_DATASETS_CACHE="{{ hf_home }}"
{% endif %}

{% if lm_eval_install %}
{% if lm_eval_install_with_python %}python -m {% endif %}pip install {{ lm_eval_install }} --no-build-isolation
{% endif %}
{% if install_commands %}
# --- Install packages ---
{{ install_commands }}
{% endif %}

WANDB_ARGS=()
{% if wandb_project %}
WANDB_ARGS=({{ wandb_args_line }})
{% endif %}

python -m lm_eval run \
  {{ lm_eval_args_lines | join(" \\\n  ") }} \
  "${WANDB_ARGS[@]}"
'
