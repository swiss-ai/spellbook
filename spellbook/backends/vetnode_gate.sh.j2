{% if vetnode %}
# --- Pre-launch vetnode gate ---
# CSCS node validation (https://docs.cscs.ch/running/vetnode/) across the whole
# allocation before any workload starts. It uses the same one-task-per-GPU layout
# as slurm_tasks, including local-rank NUMA binding. The min_bandwidth checks catch
# a node that works but is slow.
SPELLBOOK_VETNODE_ROOT="${SCRATCH:-/iopsstor/scratch/cscs/${USER}}/tmp/spellbook-vetnode/{{ vetnode_key }}"
SPELLBOOK_VETNODE_DIR="${SPELLBOOK_VETNODE_ROOT}/${SLURM_JOB_ID}"
mkdir -p "${SPELLBOOK_VETNODE_DIR}"
{%- if vetnode_exclude %}
SPELLBOOK_EXCLUDE_FILE="${SPELLBOOK_VETNODE_ROOT}/excluded.txt"

# Bad nodes go into a per-experiment exclusion list and this script is resubmitted
# without them. The list persists across jobs, so a node excluded once stays excluded.
spellbook_exclude_and_resubmit() {   # $@ = node names to exclude
  (
    flock -x 9
    {
      cat "${SPELLBOOK_EXCLUDE_FILE}" 2>/dev/null || true
      printf "%s\n" "$@"
      # Carry over anything Slurm is already excluding for this job.
      scontrol show job "${SLURM_JOB_ID}" -o \
        | sed -n 's/.* ExcNodeList=\([^ ]*\).*/\1/p' \
        | while read -r nodes; do
            [[ -z "${nodes}" || "${nodes}" == "(null)" ]] || scontrol show hostnames "${nodes}"
          done
    } | sed '/^$/d' | sort -u > "${SPELLBOOK_EXCLUDE_FILE}.tmp"
    if (( $(wc -l < "${SPELLBOOK_EXCLUDE_FILE}.tmp") > {{ vetnode_max_excluded_nodes }} )); then
      echo "vetnode exclusion limit exceeded" >&2
      exit 1
    fi
    mv -f "${SPELLBOOK_EXCLUDE_FILE}.tmp" "${SPELLBOOK_EXCLUDE_FILE}"
  ) 9>"${SPELLBOOK_EXCLUDE_FILE}.lock"

  echo "Excluding $* and retrying this job"
  sbatch --dependency=singleton \
    --exclude="$(paste -sd, "${SPELLBOOK_EXCLUDE_FILE}")" "$0"
  exit 0
}
{%- endif %}

# Vetnode's Alps evaluations require one rank per GPU. Each rank writes its own
# result; a node with a missing or failed rank is excluded as a whole.
SPELLBOOK_VETNODE_TASKS_PER_NODE={{ gpus_per_node }}
SPELLBOOK_VETNODE_CPUS_PER_TASK=$((SLURM_CPUS_ON_NODE / SPELLBOOK_VETNODE_TASKS_PER_NODE))
srun --overlap \
  --nodes="${SLURM_JOB_NUM_NODES}" \
  --ntasks="$((SLURM_JOB_NUM_NODES * SPELLBOOK_VETNODE_TASKS_PER_NODE))" \
  --ntasks-per-node="${SPELLBOOK_VETNODE_TASKS_PER_NODE}" \
  --cpus-per-task="${SPELLBOOK_VETNODE_CPUS_PER_TASK}" \
  --kill-on-bad-exit=0 \
  --wait=10 \
  --export=ALL,SPELLBOOK_VETNODE_DIR="${SPELLBOOK_VETNODE_DIR}",PYTHONNOUSERSITE=1 \
{%- if container_edf is defined and container_edf %}
  --container-env=SPELLBOOK_VETNODE_DIR,PYTHONNOUSERSITE \
  --environment="{{ container_edf }}" \
{%- endif %}
{%- if container_mounts is defined and container_mounts %}
  --container-mounts="{{ container_mounts }}" \
{%- endif %}
  --network=disable_rdzv_get \
  -u bash -lc '
    rc=0
    rank="${SLURM_LOCALID:-0}"
{%- if vetnode_install %}
    if [[ "${rank}" == "0" ]]; then
      python -m pip install --quiet {{ vetnode_install }} || rc=$?
      touch "/tmp/spellbook-vetnode-install-${SLURM_JOB_ID}-$(hostname).done"
    else
      until [[ -f "/tmp/spellbook-vetnode-install-${SLURM_JOB_ID}-$(hostname).done" ]]; do sleep 1; done
    fi
{%- endif %}
    if (( rc == 0 )); then
{%- if vetnode_numa_bind %}
      numactl --cpunodebind="${SLURM_LOCALID}" --membind="${SLURM_LOCALID}" \
{%- endif %}
      vetnode diagnose "{{ vetnode_config }}"{% if vetnode_skip_install %} --skip-install{% endif %}{% if vetnode_verbose %} --verbose{% endif %} \
        2>&1 | tee "${SPELLBOOK_VETNODE_DIR}/$(hostname).${rank}.log"
      rc=${PIPESTATUS[0]}
    fi
    echo "${rc}" > "${SPELLBOOK_VETNODE_DIR}/$(hostname).${rank}.rc"
  ' || true

SPELLBOOK_VETNODE_BAD=()
SPELLBOOK_VETNODE_BAD_COUNT=0
while read -r _node; do
  _node_failed=0
  for _rank in $(seq 0 $((SPELLBOOK_VETNODE_TASKS_PER_NODE - 1))); do
    if [[ "$(cat "${SPELLBOOK_VETNODE_DIR}/${_node}.${_rank}.rc" 2>/dev/null)" != "0" ]]; then
      _node_failed=1
    fi
  done
  if (( _node_failed )); then
    SPELLBOOK_VETNODE_BAD+=("${_node}")
    SPELLBOOK_VETNODE_BAD_COUNT=$((SPELLBOOK_VETNODE_BAD_COUNT + 1))
  fi
done < <(scontrol show hostnames "${SLURM_JOB_NODELIST}")

if (( SPELLBOOK_VETNODE_BAD_COUNT > 0 )); then
  echo "vetnode failed on: ${SPELLBOOK_VETNODE_BAD[*]} (logs in ${SPELLBOOK_VETNODE_DIR})" >&2
{%- if vetnode_exclude %}
  spellbook_exclude_and_resubmit "${SPELLBOOK_VETNODE_BAD[@]}"
{%- else %}
  exit 1
{%- endif %}
fi
echo "vetnode passed on all ${SLURM_JOB_NUM_NODES} node(s)"
rm -rf "${SPELLBOOK_VETNODE_DIR}"
{% endif %}
