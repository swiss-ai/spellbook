#!/bin/bash
# Rendered by spellbook SlurmNemoRLBackend — do not edit by hand.
#
# Owns the Slurm/container boundary and the Ray cluster topology: one head on the
# first node and one worker per remaining node. All roles share one srun step so
# NCCL actors inherit the same Slingshot VNI. The driver runs in the head task.
# {{ body_path }} runs inside the container and implements the three roles.
#
# Unlike ray.sub this does not use pyxis --container-name: Alps runs the CSCS
# container engine (--environment), with one container instance per node.
#SBATCH --job-name={{ job_name }}
#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
{%- if reservation %}
#SBATCH --reservation={{ reservation }}
{%- endif %}
{%- if qos %}
#SBATCH --qos={{ qos }}
{%- endif %}
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task={{ cpus_per_task }}
#SBATCH --gres=gpu:{{ gpus_per_node }}
#SBATCH --time={{ run_time }}
#SBATCH --exclusive
#SBATCH --output={{ log_dir }}/%x-%j.out
#SBATCH --error={{ log_dir }}/%x-%j.err
{% include "auto_requeue.sh.j2" %}

# Resolve the Ray control plane before constructing the srun arguments. These
# values must be exported both through Slurm and through the container boundary.
mapfile -t nodes_array < <(scontrol show hostnames "$SLURM_JOB_NODELIST" | sort)
num_nodes="$SLURM_JOB_NUM_NODES"
head_node="${nodes_array[0]}"
RAY_HEAD_IP="$(getent hosts "$head_node" | awk 'NR == 1 { print $1 }')"
RAY_HEAD_IP="${RAY_HEAD_IP:-$head_node}"
RAY_ADDRESS="${RAY_HEAD_IP}:{{ ray_port }}"
SPELLBOOK_RAY_STATE_DIR="{{ log_dir }}/ray-${SLURM_JOB_ID}"
mkdir -p "$SPELLBOOK_RAY_STATE_DIR"
RAY_READY_FILE="$SPELLBOOK_RAY_STATE_DIR/ready"
RAY_DONE_FILE="$SPELLBOOK_RAY_STATE_DIR/done"
export RAY_HEAD_IP RAY_ADDRESS RAY_READY_FILE RAY_DONE_FILE
# --container-env names which of the exported variables cross into the container.
# What srun forwards in the first place is srun_export_vars, an explicit list: with
# --export=ALL the submitting shell's PATH and PYTHONPATH come too.
EXPORTS="RAY_HEAD_IP,RAY_ADDRESS,RAY_READY_FILE,RAY_DONE_FILE,RAY_EXPECTED_NODES"

COMMON_SRUN_ARGS=(
  --overlap
  --export="{{ srun_export_vars }}"
  --container-env="$EXPORTS"
  {{ srun_extra_args }}
  -l
{%- if container %}
  --environment="{{ container }}"
{%- endif %}
{%- if container_mounts %}
  --container-mounts="{{ container_mounts }}"
{%- endif %}
  --container-workdir="{{ nemo_rl_path }}"
)

cleanup() {
  touch "$RAY_DONE_FILE" 2>/dev/null || true
  rm -rf "$SPELLBOOK_RAY_STATE_DIR"
}
trap cleanup EXIT TERM INT

{% include "vetnode_gate.sh.j2" %}

echo "ray: head=$head_node addr=$RAY_ADDRESS nodes=$num_nodes"

# A single job step is required on Alps: separate head/worker srun steps receive
# different Slingshot VNIs, and a cross-step NCCL communicator then fails with
# VNI_NOT_FOUND. Task zero becomes the head; the other node tasks become workers.
export RAY_EXPECTED_NODES="$num_nodes"
srun "${COMMON_SRUN_ARGS[@]}" \
  --nodes="$num_nodes" --ntasks="$num_nodes" --ntasks-per-node=1 \
  --cpus-per-task={{ cpus_per_task }} \
  --kill-on-bad-exit=1 \
  -u bash "{{ body_path }}" auto
RC=$?

echo "head/driver exited rc=$RC"
exit "$RC"
