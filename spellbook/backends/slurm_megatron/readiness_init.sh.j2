# Global readiness barrier on IOPStor. Each rank publishes completion of
# Megatron copy/package setup before any rank launches the training process.
SPELLBOOK_READY_DIR="${SPELLBOOK_READY_DIR:-${SCRATCH:-/iopsstor/scratch/cscs/${USER}}/tmp/spellbook-readiness/${SLURM_JOB_ID}}"
SPELLBOOK_READY_TIMEOUT="${SPELLBOOK_READY_TIMEOUT:-600}"
if [[ "${SLURM_PROCID}" == "0" ]]; then
  rm -rf "${SPELLBOOK_READY_DIR}"
  mkdir -p "${SPELLBOOK_READY_DIR}"
  : > "${SPELLBOOK_READY_DIR}/.initialized"
else
  until [[ -f "${SPELLBOOK_READY_DIR}/.initialized" ]]; do
    sleep 1
  done
fi
