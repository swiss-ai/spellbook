#!/bin/bash
# Memory estimation — runs estimate_013.py with --fake-process-group on a single GPU.
# credits: https://github.com/ISEEKYAN/mbridge/tree/main/memory_estimator
#
# Run directly: bash <script>.sh
# Or inside an existing allocation: SRUN_JOB_ID=<id> bash <script>.sh
set -euxo pipefail

{% include "megatron_checkout.sh.j2" %}

srun \
  ${SRUN_JOB_ID:+--jobid="${SRUN_JOB_ID}"} \
  -N 1 \
  --ntasks=1 \
  --ntasks-per-node=1 \
  --gres=gpu:{{ gpus_per_node }} \
  --mpi=pmix \
{%- if reservation %}
  --reservation={{ reservation }} \
{%- endif %}
{%- if container_edf is defined and container_edf %}
  --environment="{{ container_edf }}" \
{%- endif %}
{%- if container_mounts is defined and container_mounts %}
  --container-mounts="{{ container_mounts }}" \
{%- endif %}
{%- if container_workdir is defined and container_workdir %}
  --container-workdir="{{ container_workdir }}" \
{%- endif %}
  --no-container-mount-home \
  -A {{ account }} \
  {{ srun_extra_args }} \
  -u bash -c '
{% include "megatron_copy.sh.j2" %}
export PYTHONPATH="${MEGATRON_PATH}:{{ pythonpath }}:${PYTHONPATH:-}"
{% for key, value in env_vars.items() %}
{%- if key != "MEGATRON_PATH" %}
export {{ key }}="{{ value }}"
{%- endif %}
{%- endfor %}
pip install sentencepiece ipdb termcolor
export WORLD_SIZE=$(( SLURM_GPUS_ON_NODE * {{ nodes }} ))
export RANK=0
SLURM_NNODES={{ nodes }} WORLD_SIZE=$(( SLURM_GPUS_ON_NODE * {{ nodes }} )) RANK=0 \
  python "{{ mem_estimator_path }}/estimate_013.py" \
  --fake-process-group \
  {{ training_args_lines | join(" \\\n  ") }}
'
