# Node-health gate adapted from Guanshujie’s Megatron Slurm launcher:
# https://github.com/FFGGSSJJ/megatron-slurm-launcher
{% if node_health_gate %}
# --- Pre-launch node health gate ---
# Test the exact torch/NCCL startup path before creating an auto-requeue job.
SPELLBOOK_HEALTH_ROOT="${SCRATCH:-/iopsstor/scratch/cscs/${USER}}/tmp/spellbook-node-health/{{ node_health_gate_key }}"
SPELLBOOK_HEALTH_JOB_DIR="${SPELLBOOK_HEALTH_ROOT}/${SLURM_JOB_ID}"
SPELLBOOK_HEALTH_EXCLUDE="${SPELLBOOK_HEALTH_ROOT}/excluded.txt"
SPELLBOOK_HEALTH_TIMEOUT="${SPELLBOOK_HEALTH_TIMEOUT:-{{ node_health_gate_timeout }}}"
mkdir -p "${SPELLBOOK_HEALTH_JOB_DIR}"

cat > "${SPELLBOOK_HEALTH_JOB_DIR}/check.py" <<'PYEOF'
from datetime import timedelta
import os

import torch
import torch.distributed as dist

rank = int(os.environ.get("RANK", os.environ["SLURM_PROCID"]))
local_rank = int(os.environ.get("LOCAL_RANK", os.environ["SLURM_LOCALID"]))
world_size = int(os.environ.get("WORLD_SIZE", os.environ["SLURM_NTASKS"]))
device = torch.device("cuda", local_rank)


def log(phase: str) -> None:
    print(f"rank={rank} host={os.uname().nodename} local_rank={local_rank} phase={phase}", flush=True)


log("start")
torch.cuda.set_device(device)
dist.init_process_group(
    "nccl",
    init_method="env://",
    rank=rank,
    world_size=world_size,
    timeout=timedelta(seconds=int(os.environ["SPELLBOOK_HEALTH_TIMEOUT"])),
    device_id=device,
)
log("initialized")
dist.barrier(device_ids=[local_rank])
log("barrier")
x = torch.tensor([rank], device=device)
dist.all_reduce(x)
assert x.item() == world_size * (world_size - 1) // 2
log("all_reduce")
send = torch.full((world_size,), rank, device=device)
received = torch.empty_like(send)
dist.all_to_all_single(received, send)
assert torch.equal(received, torch.arange(world_size, device=device))
log("all_to_all")
dist.destroy_process_group()
PYEOF

spellbook_health_check() {
  local hosts="$1" nodes="$2" port="$3" log="$4"
  local master="${hosts%%,*}"
  timeout --signal=TERM "${SPELLBOOK_HEALTH_TIMEOUT}" \
    srun --overlap \
      --nodes="${nodes}" \
      --nodelist="${hosts}" \
{%- if launch_mode == "tasks" %}
      --ntasks="$((nodes * {{ gpus_per_node }}))" \
      --ntasks-per-node={{ gpus_per_node }} \
{%- else %}
      --ntasks="${nodes}" \
      --ntasks-per-node=1 \
{%- endif %}
      --kill-on-bad-exit=1 \
      --wait=10 \
      --export=ALL,MASTER_ADDR="${master}",MASTER_PORT="${port}",SPELLBOOK_HEALTH_TIMEOUT="${SPELLBOOK_HEALTH_TIMEOUT}",SPELLBOOK_HEALTH_JOB_DIR="${SPELLBOOK_HEALTH_JOB_DIR}",SPELLBOOK_HEALTH_NNODES="${nodes}" \
      --mpi=pmix \
{%- if container_edf is defined and container_edf %}
      --environment="{{ container_edf }}" \
{%- endif %}
{%- if container_mounts is defined and container_mounts %}
      --container-mounts="{{ container_mounts }}" \
{%- endif %}
      --network=disable_rdzv_get \
{%- if launch_mode == "tasks" %}
      -u bash -lc 'export RANK="${SLURM_PROCID}" LOCAL_RANK="${SLURM_LOCALID}" WORLD_SIZE="${SLURM_NTASKS}"; python "${SPELLBOOK_HEALTH_JOB_DIR}/check.py"' \
{%- else %}
      -u bash -lc 'python -m torch.distributed.run \
        --nproc_per_node={{ gpus_per_node }} \
        --nnodes="${SPELLBOOK_HEALTH_NNODES}" \
        --node_rank="${SLURM_PROCID}" \
        --master_addr="${MASTER_ADDR}" \
        --master_port="${MASTER_PORT}" \
        "${SPELLBOOK_HEALTH_JOB_DIR}/check.py"' \
{%- endif %}
      >"${log}" 2>&1
}

mapfile -t SPELLBOOK_HEALTH_NODES < <(scontrol show hostnames "${SLURM_JOB_NODELIST}")
SPELLBOOK_HEALTH_NODE_CSV="$(IFS=,; echo "${SPELLBOOK_HEALTH_NODES[*]}")"
SPELLBOOK_HEALTH_COUNT="$(printf "%s\n" "${SPELLBOOK_HEALTH_NODES[@]}" | wc -l)"
if ! spellbook_health_check \
    "${SPELLBOOK_HEALTH_NODE_CSV}" "${SPELLBOOK_HEALTH_COUNT}" 27800 \
    "${SPELLBOOK_HEALTH_JOB_DIR}/all.log"; then
  if ! grep -q 'phase=start' "${SPELLBOOK_HEALTH_JOB_DIR}/all.log"; then
    echo "Node health gate failed before the probe started; not excluding nodes" >&2
    exit 1
  fi
  if (( SPELLBOOK_HEALTH_COUNT < 4 || SPELLBOOK_HEALTH_COUNT % 2 != 0 )); then
    echo "Node health localization requires an even allocation of at least four nodes" >&2
    exit 1
  fi
  echo "Node health check failed; localizing unhealthy nodes" >&2

  spellbook_health_pair() {
    local round="$1" index="$2" first="$3" second="$4"
    local pair="${first},${second}"
    local log="${SPELLBOOK_HEALTH_JOB_DIR}/round-${round}-${index}.log"
    if ! spellbook_health_check "${pair}" 2 "$((27800 + round * 100 + index))" "${log}"; then
      if grep -q 'phase=start' "${log}"; then
        printf "%s\n%s\n" "${first}" "${second}" > "${log%.log}.failed"
      else
        : > "${log%.log}.infra"
      fi
    fi
  }

  # Two disjoint pairing rounds distinguish a bad node from its healthy peer.
  for ((i = 0; i < SPELLBOOK_HEALTH_COUNT; i += 2)); do
    spellbook_health_pair 1 "$i" \
      "${SPELLBOOK_HEALTH_NODES[$i]}" \
      "${SPELLBOOK_HEALTH_NODES[$(((i + 1) % SPELLBOOK_HEALTH_COUNT))]}" &
  done
  wait
  SPELLBOOK_HEALTH_HALF="$((SPELLBOOK_HEALTH_COUNT / 2))"
  for ((i = 0; i < SPELLBOOK_HEALTH_HALF; i++)); do
    spellbook_health_pair 2 "$i" \
      "${SPELLBOOK_HEALTH_NODES[$i]}" \
      "${SPELLBOOK_HEALTH_NODES[$((i + SPELLBOOK_HEALTH_HALF))]}" &
  done
  wait

  if compgen -G "${SPELLBOOK_HEALTH_JOB_DIR}/*.infra" > /dev/null; then
    echo "Node health pair launch failed before the probe started; not excluding nodes" >&2
    exit 1
  fi

  mapfile -t SPELLBOOK_HEALTH_BAD < <(
    cat "${SPELLBOOK_HEALTH_JOB_DIR}"/*.failed 2>/dev/null \
      | sort | uniq -c | awk '$1 >= 2 {print $2}'
  )
  if [[ -z "${SPELLBOOK_HEALTH_BAD[*]:-}" ]]; then
    echo "Health check failed but pair tests could not identify a node" >&2
    exit 1
  fi

  (
    flock -x 9
    {
      cat "${SPELLBOOK_HEALTH_EXCLUDE}" 2>/dev/null || true
      printf "%s\n" "${SPELLBOOK_HEALTH_BAD[@]}"
      scontrol show job "${SLURM_JOB_ID}" -o \
        | sed -n 's/.* ExcNodeList=\([^ ]*\).*/\1/p' \
        | while read -r nodes; do
            [[ -z "${nodes}" || "${nodes}" == "(null)" ]] || scontrol show hostnames "${nodes}"
          done
    } | sed '/^$/d' | sort -u > "${SPELLBOOK_HEALTH_EXCLUDE}.tmp"
    if (( $(wc -l < "${SPELLBOOK_HEALTH_EXCLUDE}.tmp") > {{ node_health_gate_max_excluded_nodes }} )); then
      echo "Node health exclusion limit exceeded" >&2
      exit 1
    fi
    mv -f "${SPELLBOOK_HEALTH_EXCLUDE}.tmp" "${SPELLBOOK_HEALTH_EXCLUDE}"
  ) 9>"${SPELLBOOK_HEALTH_EXCLUDE}.lock"

  SPELLBOOK_HEALTH_EXCLUDE_CSV="$(paste -sd, "${SPELLBOOK_HEALTH_EXCLUDE}")"
  echo "Excluding ${SPELLBOOK_HEALTH_BAD[*]} and retrying this job"
  sbatch --dependency=singleton --exclude="${SPELLBOOK_HEALTH_EXCLUDE_CSV}" "$0"
  exit 0
fi
rm -rf "${SPELLBOOK_HEALTH_JOB_DIR}"
{% endif %}
